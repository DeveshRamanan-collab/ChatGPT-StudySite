---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ErrorLog from '../../components/quiz/ErrorLog';
import { units } from '../../lib/content';
export async function getStaticPaths() {
  return (await units()).map((u) => ({ params: { unit: u.id }, props: { u } }));
}
const { u } = Astro.props;
---

<Layout title={`${u.data.code} error log`}>
  <Breadcrumbs items={[{ href: '/', label: 'Units' }, { href: `/${u.id}`, label: u.data.code }, { label: 'Error log' }]} />
  <h1 data-split>Error log</h1>
  <p class="lede">What you got wrong, what you chose, how sure you were, and why the right answer is right.</p>
  <div class="island-stage"><ErrorLog client:load unit={u.id} /></div>
</Layout>

<style>
  .lede { color: var(--ink-2); }
</style>
