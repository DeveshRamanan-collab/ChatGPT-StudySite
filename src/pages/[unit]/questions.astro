---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BankBrowser from '../../components/quiz/BankBrowser';
import { units } from '../../lib/content';
export async function getStaticPaths() {
  return (await units()).map((u) => ({ params: { unit: u.id }, props: { u } }));
}
const { u } = Astro.props;
---

<Layout title={`${u.data.code} question bank`}>
  <Breadcrumbs items={[{ href: '/', label: 'Units' }, { href: `/${u.id}`, label: u.data.code }, { label: 'Question bank' }]} />
  <h1 data-split>Question bank</h1>
  <div class="island-stage"><BankBrowser client:load unit={u.id} /></div>
</Layout>
