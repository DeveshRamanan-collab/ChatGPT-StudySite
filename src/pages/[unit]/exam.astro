---
import Layout from '../../layouts/Layout.astro';
import {getCollection} from 'astro:content';
import data from '../../data/rebuild/exam-info.json';
import {getLibrary} from '../../lib/rebuild';
import {conceptSlug} from '../../lib/content';
export function getStaticPaths(){return data.exams.map(exam=>({params:{unit:exam.unit},props:{exam}}));}
const {exam:e}=Astro.props;
const weeks=(await getCollection('weeks',w=>w.data.unit===e.unit)).sort((a,b)=>a.data.number-b.data.number);
const concepts=await getCollection('concepts',c=>c.data.unit===e.unit);
const aids=await getCollection('aids',a=>a.data.unit===e.unit);
const library=(await getLibrary()).filter(r=>r.units.includes(e.unit)&&(e.unit!=='laws2400'||r.listed));
const dt=(s:string)=>new Intl.DateTimeFormat('en-AU',{timeZone:data.timezone,dateStyle:'full',timeStyle:'short'}).format(new Date(s));
---
<Layout title={`${e.unit.toUpperCase()} exam`} wide centre>
<p class="label"><a href="/exams/">Exams</a> / {e.unit.toUpperCase()}</p><h1>{e.title} exam</h1><p class="rb-lede">{dt(e.start)} · AEDT</p>
<nav class="rb-actions" aria-label="Exam page"><a href="#paper">Paper & rules</a><a href="#topics">Examinable topics</a><a href="#revision">Revision notes</a><a href="#authorities">Authorities</a><a href="#standards">Marking standards</a><a href={`/studio/?unit=${e.unit}&tool=mock`}>Practice paper</a><a href={`/studio/?unit=${e.unit}&tool=notes`}>Sheet composer</a></nav>
<section id="paper"><h2>Know the paper</h2><p>{e.format}</p><div class="rb-grid"><article class="rb-card"><h3>Time</h3><p>{e.totalMinutes} minutes on the timetable. {e.writingMinutes!==null&&`${e.writingMinutes} writing minutes.`} {e.readingMinutes!==null&&`${e.readingMinutes} reading minutes.`} {e.technicalMinutes!==null&&`${e.technicalMinutes} technical minutes.`}</p><p>{e.readingRule}</p></article><article class="rb-card"><h3>Materials</h3><p>{e.materials.notes}</p>{!e.materials.universityNotesAllowanceVerified&&<p class="rb-status" data-status="unresolved">University confirmation of this unit’s notes allowance is still required.</p>}<p>{e.materials.dictionary===false&&'No dictionary. '}{e.materials.calculator===false&&'No calculator. '}{e.materials.electronicAids===false&&'No electronic aids.'}</p></article></div>
{e.questions.length>0&&<table><caption>Published paper structure · all questions compulsory where stated</caption><thead><tr><th>Question</th><th>Format</th><th>Weight</th><th>Detail</th></tr></thead><tbody>{e.questions.map(q=><tr><td>{q.number||'Not specified'}</td><td>{q.kind}</td><td>{q.weight===null?'Not specified':`${q.weight}%`}</td><td>{q.note}{q.parts.map(p=><p>Part {p.number}: {p.note}</p>)}</td></tr>)}</tbody></table>}
{e.instructions.map((x:any)=><p>{typeof x==='string'?x:x.text||x.rule||JSON.stringify(x)}</p>)}
{e.uncertainties.length>0&&<details class="rb-note" open><summary>Uncertainties and conflicting instructions · read before relying on a rule</summary><ul>{e.uncertainties.map(x=><li>{x.text}</li>)}</ul></details>}</section>
<section id="topics"><h2>What counts for this exam</h2>{e.topics.length?<ul>{e.topics.map(t=><li>{t.title}</li>)}</ul>:<p>Specific scope has not been supplied. The course library below is revision material, not a confirmed examinable topic list.</p>}{e.unit==='laws2400'&&<p class="rb-callout">The university instruction says <strong>Topics 5–12</strong>. Topic numbers are not automatically week numbers. Week links below are a study organiser; use the exact law-list filter and published topic scope to decide coverage. Intentional torts are excluded from exam practice.</p>}</section>
<section><h2>Citation rules</h2>{e.referencing.length?e.referencing.map(r=><article class="rb-note"><h3>{r.title}</h3><p>{r.rule}</p>{r.example&&<p class="mono">{r.example}</p>}</article>):<p>No unit-specific citation rule was supplied. Consult iLearn before the exam.</p>}</section>
<section id="revision"><h2>Revision notes, in one place</h2><p class="rb-muted">These are the preserved course explanations organised for revision. They are not predicted exam questions. Expand a week to read the full notes without leaving this page.</p>
{weeks.map(w=><details class="rb-note"><summary>Week {w.data.number} · {w.data.topic}</summary>{w.data.thin&&<p class="rb-status" data-status="unresolved">{w.data['thin-reason']}</p>}{concepts.filter(c=>c.data.week===w.id).map(c=>{const a=aids.find(a=>a.data.concept===c.id)?.data;return <article class="rb-revision"><h3><a href={`/${e.unit}/concept/${conceptSlug(c)}/`}>{c.data.title}</a></h3>{a?<><p>{a.plain}</p>{a.concrete&&<p><strong>See it in an example. </strong>{a.concrete}</p>}{a.formal&&<p><strong>Formal explanation. </strong>{a.formal}</p>}{a.elements.length>0&&<ol>{a.elements.map(x=><li><strong>{x.name}:</strong> {x.test}</li>)}</ol>}{a.misconceptions.map(x=><p><strong>Avoid: {x.claim}</strong> {x.correction}</p>)}{a['what-if'].map(x=><details><summary>{x.change}</summary><p>{x.effect}</p></details>)}{a.sources.length>0&&<p class="rb-muted">Sources: {a.sources.join('; ')}</p>}</>:<p><a href={`/${e.unit}/week/${w.data.number}/`}>Read the complete week</a></p>}</article>;})}<a href={`/${e.unit}/week/${w.data.number}/`}>Open continuous visual notes for this week →</a></details>)}</section>
<section id="authorities"><h2>{e.unit==='laws2400'?'Exact examinable law list':'Course case and legislation notes'}</h2><nav class="rb-actions"><a href={`/cases/?unit=${e.unit}${e.unit==='laws2400'?'&lawlist=1':''}`}>Filter cases</a><a href={`/statutes/?unit=${e.unit}${e.unit==='laws2400'?'&lawlist=1':''}`}>Filter legislation & treaties</a></nav>{library.map(r=><details class="rb-note"><summary>{r.listNumber?`${r.listNumber}. `:''}{r.title} · {r.oneLine}</summary><p>{r.plain}</p><p>{r.concrete}</p><p class="rb-preline">{r.rule}</p>{r.limits.map(x=><p><strong>Limit: </strong>{x}</p>)}<p class="rb-muted">{r.verificationNote}</p><a href={r.href}>Full facts, reasoning, operative text and sources →</a></details>)}</section>
<section id="standards"><h2>Marking standards</h2>{e.criteria.length?e.criteria.map(c=><details class="rb-note" open={c.band==='HD'}><summary>{c.band} · {c.label}</summary><p class="rb-preline">{c.text}</p></details>):<p>No unit-specific marking rubric has been supplied.</p>}{e.tips.map(t=><article class="rb-note"><h3>{t.title}</h3><p>{t.text}</p><p class="rb-muted">{t.source}</p></article>)}</section>
<p><a href={`/sources/?unit=${e.unit}`}>Inspect original exam sources</a> · <a href="/coverage/">Read the completeness and verification audit</a></p>
</Layout>