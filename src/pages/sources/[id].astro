---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {sourceIndex,sourceFile} from '../../lib/source-corpus';
export function getStaticPaths(){return sourceIndex().files.map(source=>({params:{id:source.id},props:{source}}));}
const source=sourceFile(Astro.props.source.id);
const sections=source.sections||[];
const originals=source.originals.filter(o=>o.url||o.href);
// A div preserves an initial LF; character references preserve CR through HTML parsing.
const literal=(text:string)=>text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\r/g,'&#13;');
---
<Layout title={source.title} unit={source.unit} progress centre wide>
 <Breadcrumbs items={[{href:'/',label:'Home'},{href:'/sources/',label:'Original sources'},{label:source.title}]}/>
 <p class="label">Full source · {source.unit.toUpperCase()}</p><h1 class="source-reader__title">{source.title}</h1>
 <p class="rb-lede">Full extracted text, including section numbers, punctuation, examples and speaker notes. Read extraction qualifications alongside the original document.</p>
 <nav class="rb-actions" aria-label="Source actions"><a href={`/sources/?unit=${encodeURIComponent(source.unit)}`}>Browse sources</a><a href="/coverage/">Coverage and limits</a><a href={`/source-corpus/files/${source.id}.json`} download={`${source.id}.json`}>Download extracted record</a></nav>
 <dl class="source-reader__meta"><dt>SHA-256 of original bytes</dt><dd class="mono">{source.sha256||'Original bytes were not downloaded; use the linked original.'}</dd><dt>Source paths</dt><dd>{source.paths.map(path=><p>{path}</p>)}</dd><dt>Extracted sections</dt><dd>{sections.length.toLocaleString()}</dd></dl>
 {originals.length>0&&<details class="rb-note"><summary>Open original files ({originals.length})</summary><ul>{originals.map(o=><li><a href={o.url||o.href}>{o.path||o.title||'Original source'}</a></li>)}</ul></details>}
 {source.warnings.length>0&&<aside class="rb-callout" aria-label="Extraction qualifications"><h2>Extraction qualifications</h2><ul>{source.warnings.map(w=><li>{w}</li>)}</ul><p>OCR is machine transcription and may misread letters, numbers or punctuation. It has not been certified character by character against the original images.</p></aside>}
 {sections.length>0?<><details class="rb-note"><summary>Jump to a section</summary><ol class="source-reader__jump">{sections.map(s=><li><a href={`#${s.id}`}>{s.label}</a></li>)}</ol></details><article class="source-reader" data-source-id={source.id}>{sections.map(s=><section class="source-reader__section" id={s.id} data-source-section={s.id}><h2><a href={`#${s.id}`}>{s.label}</a></h2><p class="source-reader__method">{s.method||'Extracted text'}{s.ocr?.meanConfidence!=null&&` · mean OCR confidence ${s.ocr.meanConfidence}% (machine estimate)`}</p>{s.warnings&&s.warnings.length>0&&<ul class="rb-muted">{s.warnings.map(w=><li>{w}</li>)}</ul>}<div class="source-reader__text" data-source-text set:html={literal(s.text)}/>{s.imageUrl&&<figure class="source-reader__figure"><a href={s.imageUrl}><img src={s.imageUrl} alt={`${s.label} — retained visual for checking extracted text`} loading="lazy"/></a><figcaption>Inspect the visual for diagrams and exact text that OCR may miss.</figcaption></figure>}</section>)}</article></>:<p class="rb-callout">No readable text was extracted from this file. Open the original file; this record stays in the inventory so the gap is visible.</p>}
</Layout>
<style>.source-reader__title{overflow-wrap:anywhere}.source-reader__meta{max-width:80ch;margin-block:32px}.source-reader__meta dt{font:600 var(--t-sm)/1.4 var(--font-ui);margin-top:20px}.source-reader__meta dd{margin:8px 0;overflow-wrap:anywhere}.source-reader__meta dd p{margin-block:4px}.source-reader__section{scroll-margin-top:120px;padding-block:24px;border-top:1px solid var(--line)}.source-reader__section h2{margin:0 0 12px}.source-reader__section h2 a{color:inherit;text-decoration-thickness:1px}.source-reader__method{font:var(--t-sm)/1.4 var(--font-ui);color:var(--ink-2)}.source-reader__text{white-space:pre-wrap;overflow-wrap:anywhere;word-break:normal;max-width:80ch;margin:24px 0;padding:0;border:0;background:none;color:var(--ink);font:var(--t-body)/1.6 var(--font-body);tab-size:4;overflow:visible}.source-reader__figure{margin:24px 0;max-width:80ch}.source-reader__figure img{display:block;width:100%;height:auto;background:#fff;border:1px solid var(--line)}.source-reader__figure figcaption{font:var(--t-sm)/1.4 var(--font-ui);color:var(--ink-2);margin-top:10px}.source-reader__jump{columns:2;column-gap:40px}.source-reader__jump li{padding-block:5px;break-inside:avoid}@media(max-width:600px){.source-reader__jump{columns:1}}</style>
