---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorityDetail from '../../components/rebuild/AuthorityDetail';
import SourceEvidence from '../../components/rebuild/SourceEvidence.astro';
import Backlinks from '../../components/Backlinks.astro';
import { getLibrary } from '../../lib/rebuild';
export async function getStaticPaths(){return(await getLibrary()).filter(r=>r.kind==='case').map(r=>({params:{slug:r.id},props:{r}}));}
const {r}=Astro.props;
---
<Layout title={r.title} index="Case" unit={r.units[0]} centre><Breadcrumbs items={[{href:'/',label:'Home'},{href:'/cases/',label:'Cases'},{label:r.title}]}/><h1><i>{r.title}</i></h1><p class="mono rb-muted">{r.citation}</p><p class="rb-lede">{r.oneLine}</p><AuthorityDetail client:load item={r}/><SourceEvidence unit={r.units[0]} query={r.title}/><Backlinks kind="case" id={r.id} name={r.title}/></Layout>
