---
import Layout from '../layouts/Layout.astro';
import SourceBrowser from '../components/rebuild/SourceBrowser';
import catalog from '../data/rebuild/source-catalog.json';
import data from '../data/rebuild/exam-info.json';
import {sourceIndex,sourceStats,sourceHref} from '../lib/source-corpus';
const corpus=sourceIndex(),stats=sourceStats();
const suppliedHashes=new Set(data.sourceRegistry.filter(s=>s.id.startsWith('supplied-')).map(s=>s.sha256));
const files=corpus.files.length?corpus.files.map(s=>({...s,supplied:suppliedHashes.has(s.sha256||'')})):catalog;
const missing=(corpus.missing||[]).map((s:any)=>({...s,href:s.url,paths:[s.path],originals:[{url:s.url}]}));
---
<Layout title="Original sources" wide centre>
 <p class="label">Evidence & provenance</p><h1>Original sources</h1><p class="rb-lede">Read the full extracted records behind the study notes. Slides, speaker notes, readings, examples and transcripts stay available with original wording and source links.</p>
 <nav class="rb-actions"><a href="/coverage/">Completeness audit</a><a href="/exams/">Exam command centre</a></nav>
 {corpus.files.length>0&&<p>{stats.files.toLocaleString()} source records · {stats.sections.toLocaleString()} extracted sections · {stats.characters.toLocaleString()} extracted characters.</p>}
 <p class="rb-callout">Text preservation and factual verification are separate checks. PDF text order, automatic document numbering, diagrams and machine OCR carry qualifications. Open the original or retained visual whenever an exact detail is uncertain.</p>
 <h2>Supplied exam documents</h2>{data.sourceRegistry.filter(s=>s.id.startsWith('supplied-')).map(s=><details class="rb-note"><summary>{s.filename} · {s.role}</summary><p>Reviewed: {s.reviewMethod}</p><p>{s.limitations}</p><a download={s.filename} href={`/exam-sources/${encodeURIComponent(s.filename||'')}`}>Download original file</a></details>)}
 <h2>Search the full source library</h2><SourceBrowser client:load catalog={files} missing={missing}/>
 <noscript><p>Source texts are available without JavaScript:</p><ul>{corpus.files.map(s=><li><a href={sourceHref(s.id)}>{s.title}</a></li>)}</ul></noscript>
</Layout>
