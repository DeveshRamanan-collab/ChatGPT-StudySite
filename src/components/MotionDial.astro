---
// Header motion dial: Full / Calm / Off. Persisted; the choice overrides prefers-reduced-motion.
const levels = [
  { value: 'full', label: 'Full' },
  { value: 'calm', label: 'Calm' },
  { value: 'off', label: 'Off' },
];
const { name = 'motion' } = Astro.props as { name?: string }; // a second copy (styleguide) needs its own radio group
---

<fieldset class="dial" data-motion-dial>
  <legend class="visually-hidden">Motion</legend>
  <span class="dial-label" aria-hidden="true">Motion</span>
  {levels.map((l) => (
    <label>
      <input type="radio" name={name} value={l.value} />
      <span>{l.label}</span>
    </label>
  ))}
</fieldset>

<style>
  .dial { display: inline-flex; align-items: center; gap: 2px; border: 1px solid var(--line); border-radius: var(--r-pill); padding: 2px; margin: 0; font-family: var(--font-ui); font-size: var(--t-xs); }
  .dial-label { padding-inline: var(--s-2) var(--s-1); color: var(--ink-2); }
  label { position: relative; }
  input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  span:not(.dial-label) { display: block; padding: 2px var(--s-2); border-radius: var(--r-pill); color: var(--ink-2); transition: background-color var(--dur-micro) var(--ease-hover), color var(--dur-micro) var(--ease-hover); }
  input:checked + span { background: var(--paper-3); color: var(--ink); }
  input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    input:not(:checked):hover + span { color: var(--ink); }
  }
  @media (max-width: 479px) { .dial-label { display: none; } }
</style>

<script>
  import { setMotion, motion, type MotionLevel } from '../lib/motion';
  const sync = () => {
    document.querySelectorAll<HTMLInputElement>('[data-motion-dial] input').forEach((i) => (i.checked = i.value === motion()));
  };
  document.addEventListener('astro:page-load', () => {
    sync();
    document.querySelectorAll<HTMLInputElement>('[data-motion-dial] input').forEach((i) =>
      i.addEventListener('change', () => setMotion(i.value as MotionLevel)),
    );
  });
  document.addEventListener('motionchange', sync);
</script>
